{
  "name": "nimblescape-markdown-comment-links",
  "displayName": "nimblescape Markdown Comment Links",
  "description": "Clickable Markdown links in code comments that open at the named heading.",
  "publisher": "nimblescape",
  "author": {
    "name": "nimblescape e.U.",
    "url": "https://nimblescape.com"
  },
  "version": "0.1.8",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "links",
    "comments",
    "go"
  ],
  "license": "MIT",
  "homepage": "https://nimblescape.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/nimblescape/nimblescape-markdown-comment-links.git"
  },
  "bugs": {
    "url": "https://github.com/nimblescape/nimblescape-markdown-comment-links/issues"
  },
  "qna": "https://github.com/nimblescape/nimblescape-markdown-comment-links/issues",
  "pricing": "Free",
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#1a365d",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "vscode:prepublish": "node esbuild.mjs --production",
    "package": "vsce package --no-dependencies --no-rewrite-relative-links"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/vscode": "~1.125.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onLanguage:go",
    "onLanguage:go.mod",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:json",
    "onLanguage:jsonc",
    "onLanguage:css",
    "onLanguage:scss",
    "onLanguage:less",
    "onLanguage:html",
    "onLanguage:xml",
    "onLanguage:yaml",
    "onLanguage:github-actions-workflow",
    "onLanguage:shellscript",
    "onLanguage:dockerfile",
    "onLanguage:ignore",
    "onLanguage:makefile",
    "onLanguage:toml",
    "onLanguage:properties",
    "onLanguage:ini",
    "onLanguage:sql"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "The extension reads Markdown files to open headings and changes no file."
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "configuration": {
      "title": "nimblescape Markdown Comment Links",
      "properties": {
        "nimblescape.markdownCommentLinks.hideTargets": {
          "type": "boolean",
          "default": true,
          "description": "Hide the brackets and the target of a resolved Markdown link in a comment, so that only its label shows. The lines of the cursor show the whole link."
        }
      }
    }
  }
}
