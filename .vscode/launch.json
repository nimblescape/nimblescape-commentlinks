// Build the bundle and start a second VS Code window that loads the extension
// from this folder, so that a change can be tried without a package. Open a
// folder whose comments carry Markdown links in that window. Run the
// configuration again after a change: the task "build" bundles the change.
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run the extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "build"
    }
  ]
}
